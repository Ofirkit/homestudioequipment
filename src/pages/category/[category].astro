---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../config';
import { getPosts } from '../../lib/posts';
import { breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.category === category.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: category.name, path: `/category/${category.slug}/` },
];
---

<BaseLayout
  title={`${category.name} Reviews and Buying Guides`}
  description={`${category.blurb} Reviews, comparisons, and buying advice for ${category.name.toLowerCase()} in a home studio.`}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <h1>{category.name}</h1>
  <p class="lead">{category.blurb}</p>
  {
    posts.length ? (
      <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
    ) : (
      <p>No {category.name.toLowerCase()} guides yet. They're coming soon.</p>
    )
  }
</BaseLayout>
