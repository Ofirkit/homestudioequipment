---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import StarRating from '../components/StarRating.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { getPosts, lastUpdated, formatDate, type Post } from '../lib/posts';
import { getCategory } from '../config';
import { article, breadcrumbs, faqPage } from '../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, subtitle, kind, rating, description, pubDate, author, heroImage, heroAlt, heroCredit, faq, category } =
  post.data;
const updated = lastUpdated(post);
const wasUpdated = updated.valueOf() !== pubDate.valueOf();
const cat = getCategory(category)!;
const path = `/${post.id}/`;
const pageUrl = new URL(path, Astro.site).toString();
const heroSrc = typeof heroImage === 'string' ? heroImage : heroImage?.src;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: cat.name, path: `/category/${cat.slug}/` },
];

const jsonLd = [
  article({ title, description, path, published: pubDate, modified: updated, author, image: heroSrc, section: cat.name }),
  breadcrumbs([...crumbs, { name: title, path }]),
  ...(faq?.length ? [faqPage(faq)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  image={heroSrc}
  imageAlt={heroAlt}
  jsonLd={jsonLd}
  published={pubDate}
  modified={updated}
  noindex={post.data.draft}
>
  <article class="post">
    <header class="post-header">
      <Breadcrumbs items={crumbs} linkLast />
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}

      <div class="post-meta">
        {rating !== undefined && <StarRating value={rating} />}
        <span class="kind-badge">{kind}</span>
        <span>By <a href="/about/" rel="author">{author}</a></span>
        <span class="meta-sep" aria-hidden="true"></span>
        <span class="muted">
          {wasUpdated ? 'Updated' : 'Published'}{' '}
          <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
        </span>
      </div>

      <ShareLinks url={pageUrl} title={title} image={heroSrc ? new URL(heroSrc, Astro.site).toString() : undefined} />
      <AffiliateNotice />

      {
        heroImage && (
          <figure class="post-hero">
            {typeof heroImage === 'string' ? (
              <img src={heroImage} alt={heroAlt ?? ''} width="1500" height="900" fetchpriority="high" decoding="async" />
            ) : (
              <Image
                src={heroImage}
                alt={heroAlt ?? ''}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 1100px) 100vw, 1100px"
                loading="eager"
                fetchpriority="high"
              />
            )}
            {heroCredit && <figcaption>(Image credit: {heroCredit})</figcaption>}
          </figure>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
    {faq?.length && <FAQ items={faq} />}
  </article>
</BaseLayout>
