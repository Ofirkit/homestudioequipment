---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getLiveCategories } from '../lib/posts';
import { CATEGORIES } from '../config';

const posts = (await getPosts()).slice(0, 9);
const live = new Set((await getLiveCategories()).map((c) => c.slug));
---

<BaseLayout title="Home Studio Gear Reviews">
  <section class="hero">
    <h1>Home studio gear reviews, built from real owner feedback</h1>
    <p class="lead">
      We read owner reviews on Amazon, the good and the bad, and sum up what people like, what goes wrong, and who
      each product suits, alongside the official specs. Less time researching, more time making music.
    </p>
  </section>

  <section aria-labelledby="cats">
    <h2 id="cats">Browse by category</h2>
    <ul class="category-grid">
      {
        CATEGORIES.map((c) => (
          <li>
            {live.has(c.slug) ? (
              <a href={`/category/${c.slug}/`}>
                <strong>{c.name}</strong>
                <span>{c.blurb}</span>
              </a>
            ) : (
              <div class="category-soon">
                <strong>{c.name}</strong>
                <span>{c.blurb}</span>
                <span class="eyebrow">Coming soon</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="latest">
    <h2 id="latest">Latest reviews and guides</h2>
    {
      posts.length ? (
        <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <p>The first reviews are on the way. Check back soon.</p>
      )
    }
  </section>
</BaseLayout>
