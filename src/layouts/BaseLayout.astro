---
import '../styles/global.css';
import { SITE } from '../config';
import { getLiveCategories } from '../lib/posts';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  /** Alt text for the social sharing image. */
  imageAlt?: string;
  /** Pixel size of `image`, when known. Falls back to the 1200x630 default image size. */
  imageWidth?: number;
  imageHeight?: number;
  jsonLd?: object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  jsonLd = [],
  noindex = false,
  published,
  modified,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Keep <title> within ~60 characters so Google doesn't truncate it: drop the site-name suffix on long titles.
const suffixed = `${title} | ${SITE.name}`;
const fullTitle = title === SITE.name || suffixed.length > 60 ? title : suffixed;
const ogImage = new URL(image ?? SITE.ogImage, Astro.site).toString();
const ogWidth = image ? imageWidth : 1200;
const ogHeight = image ? imageHeight : 630;
const schemas = [organization(), website(), ...jsonLd];
const year = new Date().getFullYear();
// Only link categories that have published posts; empty ones are noindexed placeholders.
const navCategories = await getLiveCategories();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} reviews`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.author} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? `${SITE.name}: home studio gear reviews`} />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site summary" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Umami analytics (cookieless). Tracks visits only on the live domain, not localhost. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="103a0bcd-f66e-400e-a850-52ea78d89b9e"
      data-domains="homestudioequipment.com"
    ></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">Home<span>Studio</span>Equipment</a>
        <nav aria-label="Categories">
          <ul>
            {navCategories.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="small">
          As an Amazon Associate, {SITE.name} earns from qualifying purchases.{' '}
          <a href="/affiliate-disclosure/">Learn more</a>.
        </p>
        <nav aria-label="Site">
          <a href="/about/">About</a>
          <a href="/how-we-review/">How We Review</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p class="small">© {year} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
