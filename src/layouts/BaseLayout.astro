---
import '../styles/global.css';
import { SITE, CATEGORIES } from '../config';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  jsonLd?: object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  image,
  jsonLd = [],
  noindex = false,
  published,
  modified,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Keep <title> within ~60 characters so Google doesn't truncate it: drop the site-name suffix on long titles.
const suffixed = `${title} | ${SITE.name}`;
const fullTitle = title === SITE.name || suffixed.length > 60 ? title : suffixed;
const ogImage = new URL(image ?? SITE.ogImage, Astro.site).toString();
const schemas = [organization(), website(), ...jsonLd];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.author} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site summary" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">Home<span>Studio</span>Equipment</a>
        <nav aria-label="Categories">
          <ul>
            {CATEGORIES.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="small">
          As an Amazon Associate, {SITE.name} earns from qualifying purchases.
          <a href="/affiliate-disclosure/">Learn more</a>.
        </p>
        <nav aria-label="Site">
          <a href="/about/">About</a>
          <a href="/how-we-review/">How We Review</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p class="small">© {year} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
