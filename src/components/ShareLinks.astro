---
interface Props {
  url: string;
  title: string;
  image?: string;
}
const { url, title, image } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    color: '#1877f2',
    icon: 'M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21z',
  },
  {
    name: 'X',
    href: `https://x.com/intent/post?url=${u}&text=${t}`,
    color: '#000',
    icon: 'M17.2 4h2.8l-6.1 6.9L21 20h-5.6l-4.4-5.7L6 20H3.2l6.5-7.4L3 4h5.7l4 5.2zm-1 14.4h1.6L7.9 5.5H6.2z',
  },
  {
    name: 'Reddit',
    href: `https://www.reddit.com/submit?url=${u}&title=${t}`,
    color: '#ff4500',
    icon: 'M21 12.1a2 2 0 0 0-3.4-1.4 9.8 9.8 0 0 0-5.3-1.7l.9-4.2 2.9.6a1.4 1.4 0 1 0 .2-1l-3.3-.7a.5.5 0 0 0-.6.4l-1 4.7a9.8 9.8 0 0 0-5.4 1.7 2 2 0 1 0-2.2 3.3v.6c0 3 3.5 5.5 7.8 5.5s7.8-2.5 7.8-5.5v-.6a2 2 0 0 0 1.4-1.7zM7.6 13.4a1.4 1.4 0 1 1 2.8 0 1.4 1.4 0 0 1-2.8 0zm7.8 3.7a5.2 5.2 0 0 1-3.4 1 5.2 5.2 0 0 1-3.4-1 .4.4 0 0 1 .5-.6 4.4 4.4 0 0 0 2.9.8 4.4 4.4 0 0 0 2.9-.8.4.4 0 0 1 .5.6zm-.3-2.3a1.4 1.4 0 1 1 0-2.8 1.4 1.4 0 0 1 0 2.8z',
  },
  {
    name: 'Pinterest',
    href: `https://www.pinterest.com/pin/create/button/?url=${u}&description=${t}${image ? `&media=${encodeURIComponent(image)}` : ''}`,
    color: '#e60023',
    icon: 'M12.3 3C7.4 3 5 6.5 5 9.4c0 1.8.7 3.3 2.1 3.9.2.1.4 0 .5-.3l.2-.8c.1-.3 0-.4-.2-.6-.4-.5-.7-1.2-.7-2.1 0-2.7 2-5.2 5.3-5.2 2.9 0 4.5 1.8 4.5 4.1 0 3.1-1.4 5.7-3.4 5.7-1.1 0-2-.9-1.7-2.1.3-1.4 1-2.9 1-3.9 0-.9-.5-1.6-1.5-1.6-1.2 0-2.1 1.2-2.1 2.8 0 1 .3 1.7.3 1.7l-1.4 6c-.4 1.8-.1 3.9 0 4.1 0 .1.2.2.3.1.1-.2 1.5-1.9 2-3.6l.8-3c.4.7 1.5 1.4 2.7 1.4 3.6 0 6-3.3 6-7.6C19 6.1 16.2 3 12.3 3z',
  },
  {
    name: 'Email',
    href: `mailto:?subject=${t}&body=${u}`,
    color: '#44403c',
    icon: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm.8 1.8v.3l7.2 4.8 7.2-4.8v-.3zm14.4 2.4-7.2 4.7-7.2-4.7V16h14.4z',
  },
];
---

<ul class="share" aria-label="Share this article">
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          style={`--c:${l.color}`}
          aria-label={`Share on ${l.name}`}
          title={`Share on ${l.name}`}
          {...(l.name === 'Email' ? {} : { target: '_blank', rel: 'noopener' })}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d={l.icon} fill="currentColor" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
