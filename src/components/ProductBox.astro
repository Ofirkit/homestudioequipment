---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AmazonButton from './AmazonButton.astro';

interface Props {
  name: string;
  verdict: string;
  pros: string[];
  cons: string[];
  asin?: string;
  /** Ready-made affiliate link; overrides `asin`. */
  href?: string;
  /**
   * A local image (imported, gets optimized) or a remote URL.
   * Amazon product images must be remote: Amazon's rules don't allow downloading and re-hosting them.
   */
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Optional ribbon, e.g. "Best overall". */
  badge?: string;
}

const { name, verdict, pros, cons, asin, href, image, imageAlt, badge } = Astro.props;
---

<section class="product-box" aria-label={name}>
  {badge && <p class="badge">{badge}</p>}
  <div class="product-head">
    {
      typeof image === 'string' ? (
        <img src={image} alt={imageAlt ?? name} width="240" height="240" loading="lazy" decoding="async" class="product-img" />
      ) : (
        image && <Image src={image} alt={imageAlt ?? name} width={240} loading="lazy" class="product-img" />
      )
    }
    <div>
      <h3>{name}</h3>
      <p class="verdict">{verdict}</p>
    </div>
  </div>
  <div class="pros-cons">
    <div>
      <h4>Pros</h4>
      <ul class="pros">{pros.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div>
      <h4>Cons</h4>
      <ul class="cons">{cons.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>
  <AmazonButton href={href} asin={asin} name={name} />
</section>
