---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AmazonButton from './AmazonButton.astro';

interface Props {
  name: string;
  verdict: string;
  pros: string[];
  cons: string[];
  asin?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Optional ribbon, e.g. "Best overall". */
  badge?: string;
}

const { name, verdict, pros, cons, asin, image, imageAlt, badge } = Astro.props;
---

<section class="product-box" aria-label={name}>
  {badge && <p class="badge">{badge}</p>}
  <div class="product-head">
    {image && <Image src={image} alt={imageAlt ?? name} width={240} loading="lazy" class="product-img" />}
    <div>
      <h3>{name}</h3>
      <p class="verdict">{verdict}</p>
    </div>
  </div>
  <div class="pros-cons">
    <div>
      <h4>Pros</h4>
      <ul class="pros">{pros.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div>
      <h4>Cons</h4>
      <ul class="cons">{cons.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>
  <AmazonButton asin={asin} name={name} />
</section>
